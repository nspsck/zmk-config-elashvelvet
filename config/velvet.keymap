/*
 * Corne Colemak-DH port. Only key behaviors and pointer processing live here;
 * Velvet's matrix, pins, buses, sensor orientation and peripheral power stay in
 * boards/shields/velvet unchanged.
 */

#include "velvet-layers.h"

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>

/* Do not enable soft-off or RGB hardware support just to satisfy a binding. */

#if defined(CONFIG_ZMK_PM_SOFT_OFF)

#define VELVET_SOFT_OFF soft_off

&soft_off { hold-time-ms = <2000>; };

#else

#define VELVET_SOFT_OFF none

#endif

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/* Only the right half owns the trackball and its runtime processors. These are
 * software defaults; settings already saved in DYA Studio take precedence. */

#if defined(CONFIG_SHIELD_VELVET_RIGHT)

#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mouse_runtime_input_processor {
    scale-multiplier = <3>;
    scale-divisor = <4>;
};

&scroll_runtime_input_processor {
    scale-multiplier = <1>;
    scale-divisor = <80>;
};

&{/trackball_listener} {
    /* Keep the existing runtime mouse processor for Studio customization. */

    scroller { layers = <VELVET_LAYER_SCROLL>; };

    /* One-third of normal speed, preserving any Studio rotation/inversion.
     * At the default 3/4 normal scale this is 1/4 of raw movement. Releasing
     * the key restores normal processing without writing persistent settings.
     * Scrolling wins if both keys are held: scroller is declared first. */

    precision {
        layers = <VELVET_LAYER_PRECISION>;
        input-processors = <&mouse_runtime_input_processor &zip_xy_scaler 1 3>;
    };
};

#endif

&mt {
    tapping-term-ms = <180>;
    quick-tap-ms = <180>;
    require-prior-idle-ms = <150>;
    flavor = "tap-preferred";
    hold-trigger-key-positions = <26 27 28 29 33 34 35 36>;
    hold-trigger-on-release;
};

/ {
    behaviors {
        mod_kp: mod_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_KP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <130>;
            flavor = "hold-preferred";
            quick-tap-ms = <130>;
            hold-trigger-key-positions = <53 55 56 58 54 57>;
        };

        to_kp: to_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "TO_KP";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            flavor = "tap-preferred";
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <32 33 34 35 36 19 20 21 22 23 45 46 47 48 49 56 57 58>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <14 15 16 17 27 28 29 30 40 41 42 43 13 26 39 53 54 55>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };

        mt_pinky: mt_pinky {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_PINKY";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <26 36>;
            flavor = "tap-preferred";
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Keep Velvet's existing bootloader chord on the extra number row. */

        flash {
            bindings = <&bootloader>;
            key-positions = <0 11>;
        };

        #if defined(CONFIG_ZMK_PM_SOFT_OFF)

#

        endif

        mousemiddle {
            bindings = <&mkp MCLK>;
            key-positions = <51 52>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "CMKDH";
            bindings = <
&kp GRAVE  &kp N1       &kp N2       &kp N3            &kp N4         &kp N5                 &kp N6     &kp N7         &kp N8        &kp N9          &kp N0       &kp LG(DELETE)
&kp ESC    &kp Q        &kp W        &kp F             &kp P          &kp B      &kp K_NEXT  &kp J      &kp L          &kp U         &kp Y           &kp SEMI     &kp BACKSPACE
&kp TAB    &hml LGUI A  &hml LALT R  &hml LCTRL S      &hml LSHIFT T  &kp G      &to 1       &kp M      &hmr RSHIFT N  &hmr RCTRL E  &hmr RALT I     &hmr RGUI O  &kp SINGLE_QUOTE
&kp EQUAL  &kp Z        &kp X        &kp C             &kp D          &kp V      &kp K_PREV  &kp K      &kp H          &kp COMMA     &kp DOT         &kp SLASH    &kp MINUS
           &mkp LCLK    &mkp RCLK    &mod_kp 5 DELETE  &mo 2          &kp SPACE              &kp ENTER  &mo 3          &kp CAPS      &kp LEFT_ARROW  &kp RIGHT
            >;

            sensor-bindings = <&rsr_vol>;
        };

        layer_1 {
            display-name = "GAMING";
            bindings = <
&kp ESC  &kp N1      &kp N2        &kp N3        &kp N4        &kp N5                &kp N6     &kp N7    &kp N8        &kp N9                   &kp N0                      &kp BACKSPACE
&kp ESC  &kp N1      &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5     &mkp RCLK  &none      &none     &kp UP_ARROW  &none                    &none                       &kp BACKSPACE
&kp TAB  &kp Q       &kp W         &kp E         &kp R         &kp T      &mkp MCLK  &none      &kp LEFT  &kp DOWN      &kp RIGHT                &none                       &none
&kp B    &kp A       &kp S         &kp D         &kp F         &kp G      &mkp LCLK  &none      &none     &none         &none                    &none                       &none
         &kp C_MUTE  &kp C_PP      &kp LCTRL     &kp LEFT_ALT  &kp SPACE             &kp ENTER  &to 0     &to 0         &mo VELVET_LAYER_SCROLL  &mo VELVET_LAYER_PRECISION
            >;

            sensor-bindings = <&rsr_vol>;
        };

        layer_2 {
            display-name = "SYMNUM";
            bindings = <
&trans     &trans          &trans        &trans         &trans          &trans                 &trans         &trans          &trans         &trans        &trans                &trans
&kp TILDE  &kp LS(EXCL)    &kp LS(AT)    &kp LS(POUND)  &kp LS(DLLR)    &kp LS(PRCNT)  &trans  &kp LS(CARET)  &kp LS(AMPS)    &kp LS(STAR)   &kp PIPE      &kp BSLH              &none
&kp GRAVE  &hml LGUI N1    &hml LALT N2  &hml LCTRL N3  &hml LSHIFT N4  &kp N5         &trans  &kp N6         &hmr RSHIFT N7  &hmr RCTRL N8  &hmr RALT N9  &hmr RGUI N0          &none
&none      &mt PLUS EQUAL  &kp LBKT      &kp LBRC       &kp LPAR        &kp TILDE      &trans  &kp GRAVE      &kp RPAR        &kp RBRC       &kp RBKT      &mt UNDERSCORE MINUS  &none
           &trans          &trans        &none          &trans          &none                  &none          &trans          &none          &trans        &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };

        layer_3 {
            display-name = "FN";
            bindings = <
&trans  &trans        &trans        &trans         &trans          &trans              &trans        &trans            &trans         &trans            &trans        &trans
&none   &kp F1        &kp F2        &kp F3         &kp F4          &kp F5      &trans  &kp C_MUTE    &kp C_VOL_DN      &kp C_VOL_UP   &kp C_PLAY_PAUSE  &kp C_PP      &none
&none   &hml LGUI F6  &hml LALT F7  &hml LCTRL F8  &hml LSHIFT F9  &kp F10     &trans  &kp LEFT      &hmr RSHIFT DOWN  &hmr RCTRL UP  &hmr RALT RIGHT   &kp LGUI      &none
&none   &kp F11       &kp F12       &none          &none           &bt BT_CLR  &trans  &bt BT_SEL 0  &bt BT_SEL 1      &bt BT_SEL 2   &bt BT_SEL 3      &bt BT_SEL 4  &none
        &trans        &trans        &none          &trans          &kp CAPS            &none         &trans            &none          &trans            &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };

        layer_4 {
            display-name = "MOUSE";
            bindings = <
&trans       &trans           &trans          &trans          &trans           &trans                   &trans     &trans            &trans           &trans          &trans                &trans
&kp ESC      &bootloader      &mkp MB2        &mmv MOVE_UP    &mkp MB1         &kp PRINTSCREEN  &trans  &mkp MCLK  &kp KP_N7         &kp KP_N8        &kp KP_N9       &bootloader           &kp LC(LA(DELETE))
&none        &msc SCRL_RIGHT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP     &trans  &mkp MB1   &mt LSHIFT KP_N4  &mt LCTRL KP_N5  &mt LALT KP_N6  &mt_pinky LGUI KP_N0  &none
&bootloader  &msc SCRL_LEFT   &mkp MB4        &mkp MCLK       &mkp MB5         &msc SCRL_DOWN   &trans  &mkp MB2   &kp KP_N1         &kp KP_N2        &kp KP_N3       &kp KP_NUM            &bootloader
             &trans           &trans          &none           &trans           &none                    &none      &trans            &none            &trans          &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };

        layer_5 {
            display-name = "WM";
            bindings = <
&trans  &trans          &trans          &trans          &trans          &trans                  &trans          &trans          &trans          &trans          &trans          &trans
&none   &kp LS(LG(N1))  &kp LS(LG(N2))  &kp LS(LG(N3))  &kp LS(LG(N4))  &kp LS(LG(N5))  &trans  &kp LS(LG(N6))  &kp LS(LG(N7))  &kp LS(LG(N8))  &kp LS(LG(N9))  &kp LS(LG(N0))  &none
&none   &kp LG(N1)      &kp LG(N2)      &kp LG(N3)      &kp LG(N4)      &kp LG(N5)      &trans  &kp LG(N6)      &kp LG(N7)      &kp LG(N8)      &kp LG(N9)      &kp LG(N0)      &none
&none   &none           &none           &none           &none           &none           &trans  &none           &none           &none           &none           &none           &none
        &trans          &trans          &trans          &none           &none                   &none           &none           &none           &trans          &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };

        layer_6 {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };

        layer_7 {
            display-name = "PRECISION";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        mouse_numpad {
            if-layers = <VELVET_LAYER_SYMNUM VELVET_LAYER_FN>;
            then-layer = <VELVET_LAYER_MOUSE>;
        };
    };
};
